{
  "manifest_version": 3,
  "name": "Kartaan Click TEST - C2-0 label probe",
  "version": "0.0.1",
  "description": "TEST copy, never released. Only WATCHES for the Flipkart label PDF you print yourself. Clicks nothing.",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://seller.flipkart.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kartaan Click TEST - C2-0 label probe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
