{
  "manifest_version": 3,
  "name": "Kartaan Click",
  "version": "1.1.0",
  "description": "Free workflow fixes for seller and warehouse tools: clears the VMS packing box, and works through Flipkart orders one click at a time.",
  "homepage_url": "https://kartaan.com",

  "permissions": ["storage", "downloads"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://*.synlabs.io/*"],
      "js": ["content/vms-awb.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seller.flipkart.com/*"],
      "js": ["content/fk-orders.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
