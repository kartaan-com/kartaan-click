{
  "manifest_version": 3,
  "name": "Kartaan Click",
  "version": "1.8.0",
  "description": "Free fixes for seller tools: the VMS packing box clears itself, Flipkart orders go one click at a time, orders get accepted.",
  "homepage_url": "https://kartaan.com",
  "key": "",

  "permissions": ["storage", "downloads", "alarms", "idle", "notifications", "activeTab", "scripting"],

  "host_permissions": [
    "https://seller.flipkart.com/*",
    "https://supplier.meesho.com/*",
    "https://storage.googleapis.com/*",
    "https://sellercentral.amazon.in/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; frame-ancestors 'none'"
  },

  "externally_connectable": { "matches": ["https://kartaan.com/label-cropper/*"] },

  "background": {
    "service_worker": "background.js"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["https://seller.flipkart.com/*", "https://supplier.meesho.com/*", "https://sellercentral.amazon.in/*"],
      "js": ["content/kc-shrink.js", "content/kc-stale.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.synlabs.io/*"],
      "js": ["content/vms-awb.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://seller.flipkart.com/*"],
      "js": ["content/kc-accept-rules.js", "content/fk-orders.js", "content/checkin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://supplier.meesho.com/*"],
      "js": ["content/kc-accept-rules.js", "content/meesho-orders.js", "content/meesho-labels.js", "content/checkin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://sellercentral.amazon.in/*"],
      "js": ["content/checkin.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
