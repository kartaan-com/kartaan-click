#!/bin/sh
# Refuses the commit if it breaks a release rule. The rules are in tools/check.js.
#
# This is turned on by:  git config core.hooksPath .githooks
# It is not the only guard — GitHub runs the same checks on every push, so a
# machine without this configured still cannot get a broken commit onto main.

echo "checking the release rules..."
node tools/check.js || {
  echo ""
  echo "COMMIT REFUSED — see above."
  echo "Nothing has been committed. Fix the points listed, then commit again."
  exit 1
}

# Every commit here is authored by the same person. Rather than write that
# address into a public file, this compares against whoever authored the last
# commit — same effect, nothing published.
who="$(git config user.email)"
expected="$(git log -1 --format='%ae' 2>/dev/null)"
if [ -n "$expected" ] && [ "$who" != "$expected" ]; then
  echo ""
  echo "COMMIT REFUSED — every commit in this repository is authored by the same"
  echo "person, and this one would not be. Check 'git config user.email'."
  exit 1
fi
